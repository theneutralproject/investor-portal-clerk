generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  clerkId         String          @unique
  role            Role            @default(USER)
  email           String          @unique
  firstName       String
  lastName        String
  phoneNumber     String?
  hubspotId       String
  addressId       Int?
  ssn             String?
  title           String?
  documentEvents  DocumentEvent[]
  address         Address?        @relation(fields: [addressId], references: [id])
  ownedDeal       Deal[]          @relation(name: "ownedDeal")
  cosignedDeal    Deal[]          @relation(name: "cosignedDeal")
  companyOwned    Company[]       @relation(name: "companyOwner")
  companyCosigned Company[]       @relation(name: "companyCosigner")
  UserDocument    UserDocument[]
}

model Deal {
  id                      Int                    @id @default(autoincrement())
  projectId               Int
  project                 Project                @relation(fields: [projectId], references: [id])
  userId                  Int
  owner                   User                   @relation(fields: [userId], references: [id], name: "ownedDeal")
  cosigners               User[]                 @relation(name: "cosignedDeal")
  dealStage               Int
  amount                  Int
  financingType           DealFinancingType?     @default(equity)
  hubspotId               String                 @unique
  transactionId           String                 @default("")
  /// the project, i.e. Edison LLC
  investmentEntity        String
  numberAUnits            Float?                 @default(0.0)
  numberCUnits            Float?                 @default(0.0)
  ownershipType           DealOwnershipType?
  ownershipTypeOtherValue String?
  AccreditationVerifier   AccreditationVerifier? @relation(fields: [accreditationVerifierId], references: [id])
  accreditationVerifierId Int?
  Company                 Company?               @relation(fields: [companyId], references: [id])
  companyId               Int?
  UserDocument            UserDocument[]
}

/// if deal.ownershipType === 'CORPROTATION', 'PARTNERSHIP', 'TRUST', create an Company
model Company {
  id             Int            @id @default(autoincrement())
  name           String
  tin            String?
  dateOfCreation DateTime?
  juristication  String?
  ownerId        Int
  owner          User           @relation(fields: [ownerId], references: [id], name: "companyOwner")
  cosigners      User[]         @relation(name: "companyCosigner")
  deals          Deal[]
  UserDocument   UserDocument[]

  @@map("Company")
}

model AccreditationVerifier {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String
  title       String
  phoneNumber String
  deals       Deal[]
}

/// user specific documents such as tax forms, accreditation verification etc 
model UserDocument {
  id               Int              @id @default(autoincrement())
  name             String
  ownerId          Int
  owner            User             @relation(fields: [ownerId], references: [id])
  link             String
  userDocumentType UserDocumentType
  dealId           Int?
  deal             Deal?            @relation(fields: [dealId], references: [id])
  companyId        Int?
  company          Company?         @relation(fields: [companyId], references: [id])
}

enum UserDocumentType {
  TAX
  VERIFICATION_ACCREDITATION
  BUSINESS
}

model Project {
  id                   Int        @id @default(autoincrement())
  name                 String     @unique
  location             String
  investmentGoal       Float      @default(0.0)
  investmentRaised     Float      @default(0.0)
  tags                 String     @default("")
  status               Status     @default(ACTIVE)
  description          String
  buildingAvgRent      Int        @default(0)
  buildingAvgUnitSize  Int        @default(0)
  buildingCommSqFt     Int        @default(0)
  buildingUnits        Int        @default(0)
  debtInterestRate     String     @default("")
  debtMinInvestment    Int        @default(25000)
  debtPaymentFreq      String     @default("quarterly")
  debtTermMonths       Int        @default(48)
  equityIRR            Float      @default(0.0)
  equityMinInvestment  Int        @default(250000)
  equityPaymentFreq    String     @default("quarterly")
  equityTermMonths     Int        @default(60)
  marketHighlights     String     @default("")
  youtubeUrl           String     @default("")
  preferredReturn      String     @default("")
  targetEquityMultiple Float      @default(0.0)
  slug                 String?    @unique
  deals                Deal[]
  documents            Document[]
  pictures             Pictures[]
}

model Pictures {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

/// project documents that all logged in users can see
model Document {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  project            Project             @relation(fields: [projectId], references: [id])
  documentEvents     DocumentEvent[]
}

model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  documentId Int
  date       DateTime
  type       DocumentEventType
  document   Document          @relation(fields: [documentId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

model Address {
  id      Int    @id @default(autoincrement())
  street  String
  city    String
  zipcode String
  state   String
  user    User[]
}

/// Role is not yet used
enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPROTATION
  TRUST
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
}
