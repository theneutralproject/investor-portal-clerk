generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id             Int             @id @default(autoincrement())
  clerkId        String          @unique
  role           Role
  email          String          @unique
  firstName      String
  lastName       String
  phoneNumber    String
  meetings       Meeting[]
  deals          Deal[]
  documentEvents DocumentEvent[]
}

model Meeting {
  id        Int      @id @default(autoincrement())
  url       String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  time      DateTime
}

enum Status {
  ACTIVE
  INACTIVE
}

model Project {
  id               Int        @id @default(autoincrement())
  status           Status     @default(ACTIVE)
  name             String
  location         String
  tags             String     @default("")
  pictures         Pictures[]
  investmentRaised Int        @default(0)
  investmentGoal   Int        @default(0)
  numUnits         Int        @default(0)
  projectIrr       Decimal    @default(0.0)
  meetings         Meeting[]
  documents        Document[]
  deals            Deal[]
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
}

model Pictures {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id])
  url       String
  type      PictureType
}

model Document {
  id             Int             @id @default(autoincrement())
  name           String
  fileName       String
  description    String
  link           String
  projectId      Int
  project        Project         @relation(fields: [projectId], references: [id])
  dealStage      Int
  documentEvents DocumentEvent[]
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  documentId Int
  document   Document          @relation(fields: [documentId], references: [id])
  date       DateTime
  type       DocumentEventType
}

model Deal {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id])
  dealStage Int
  amount    Int
}
