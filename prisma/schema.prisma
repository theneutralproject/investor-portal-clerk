generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int             @id @default(autoincrement())
  clerkId             String          @unique
  role                Role            @default(USER)
  email               String          @unique
  firstName           String
  lastName            String
  phoneNumber         String?
  hubspotId           String
  addressId           Int?
  ssn                 String?
  title               String?
  userOrgId           Int?            @unique
  documentEvents      DocumentEvent[]
  address             Address?        @relation(fields: [addressId], references: [id])
  primaryOrganization Organization?   @relation("userOrg", fields: [userOrgId], references: [id])
  organization        Organization[]  @relation("allOrgs")
  deal                Deal[] /// @deprecated Use `organization.deal` instead.
}

model Deal {
  id                      Int                    @id @default(autoincrement())
  projectId               Int
  dealStage               Int
  amount                  Float                  @default(0.0)
  financingType           DealFinancingType?     @default(equity)
  hubspotId               String                 @unique
  transactionId           String                 @default("")
  investmentEntity        String /// the project, i.e. Edison LLC
  numberAUnits            Float?                 @default(0.0)
  numberCUnits            Float?                 @default(0.0)
  ownershipType           DealOwnershipType?     @default(INDIVIDUAL)
  accreditationVerifierId Int?
  organizationId          Int
  userId                  Int? /// @deprecated Use `organizationId` instead.
  AccreditationVerifier   AccreditationVerifier? @relation(fields: [accreditationVerifierId], references: [id])
  organization            Organization           @relation(fields: [organizationId], references: [id])
  project                 Project                @relation(fields: [projectId], references: [id])
  document                DealDocument[]
  user                    User?                  @relation(fields: [userId], references: [id]) /// @deprecated Use `organization` instead.
}

model Organization {
  id             Int                    @id @default(autoincrement())
  name           String
  ownerId        Int?                   @unique
  tin            String?
  dateOfCreation DateTime?
  juristication  String?
  addressId      Int?
  ownershipType  DealOwnershipType      @default(INDIVIDUAL)
  deals          Deal[]
  address        Address?               @relation(fields: [addressId], references: [id])
  document       OrganizationDocument[]
  ownedBy        User?                  @relation("userOrg")
  members        User[]                 @relation("allOrgs")
}

model AccreditationVerifier {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String
  title       String
  phoneNumber String
  deals       Deal[]
}

/// deal specific documents such as tax forms, accreditation verification etc 
model DealDocument {
  id     Int              @id @default(autoincrement())
  name   String
  link   String
  type   DealDocumentType
  dealId Int
  deal   Deal             @relation(fields: [dealId], references: [id])
}

/// used for business verification letters and such
model OrganizationDocument {
  id             Int          @id @default(autoincrement())
  name           String
  link           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Project {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  location               String
  investmentGoal         Float                    @default(0.0) /// @deprecated
  investmentRaised       Float                    @default(0.0) /// @deprecated
  tags                   String                   @default("")
  status                 Status                   @default(ACTIVE)
  description            String
  buildingAvgRent        Int                      @default(0) /// @deprecated
  buildingAvgUnitSize    Int                      @default(0) /// @deprecated
  buildingCommSqFt       Int                      @default(0) /// @deprecated
  buildingUnits          Int                      @default(0) /// @deprecated
  cUnitThresholdAmount   Float                    @default(200000.0) /// @deprecated
  debtInterestRate       String                   @default("") /// @deprecated
  debtMinInvestment      Int                      @default(25000) /// @deprecated
  debtPaymentFreq        String                   @default("quarterly") /// @deprecated
  debtTermMonths         Int                      @default(48) /// @deprecated
  equityIRR              Float                    @default(0.0) /// @deprecated
  equityMinInvestment    Int                      @default(250000) /// @deprecated
  equityPaymentFreq      String                   @default("quarterly") /// @deprecated
  equityTermMonths       Int                      @default(60) /// @deprecated
  marketHighlights       String                   @default("")
  youtubeUrl             String                   @default("")
  preferredReturn        String                   @default("") /// @deprecated
  targetEquityMultiple   Float                    @default(0.0) /// @deprecated
  slug                   String                   @unique
  equityReturnsFile      String?
  deals                  Deal[]
  documents              ProjectDocument[]
  pictures               ProjectPicture[]
  projectMilestones      ProjectMilestones?
  ProjectPropertyStats   ProjectPropertyStats[]
  ProjectInvestmentStats ProjectInvestmentStats[]
}

model ProjectPropertyStats {
  id             Int     @id @default(autoincrement())
  avgRent        Int     @default(0)
  avgUnitSize    Int     @default(0)
  commercialSqFt Int     @default(0)
  numUnits       Int     @default(0)
  projectId      Int
  project        Project @relation(fields: [projectId], references: [id])
}

model ProjectInvestmentStats {
  id                   Int     @id @default(autoincrement())
  cUnitThresholdAmount Float   @default(200000.0)
  debtInterestRate     String  @default("")
  debtMinInvestment    Int     @default(5000)
  debtPaymentFreq      String  @default("quarterly")
  debtTermMonths       Int     @default(48)
  equityIRR            Float   @default(0.0)
  equityMinInvestment  Int     @default(5000)
  equityPaymentFreq    String  @default("quarterly")
  equityTermMonths     Int     @default(60)
  preferredReturn      String  @default("")
  investmentGoal       Float   @default(0.0)
  investmentRaised     Float   @default(0.0)
  projectId            Int
  project              Project @relation(fields: [projectId], references: [id])
}

model ProjectMilestones {
  id                        Int       @id @default(autoincrement())
  projectId                 Int       @unique
  equityContribution        DateTime
  financialClosing          DateTime
  groundBreakingCeremony    DateTime?
  startVerticalConstruction DateTime?
  toppingOut                DateTime?
  preLeasing                DateTime?
  fullEnclosure             DateTime?
  temporaryOccupancy        DateTime
  grandOpening              DateTime
  stabilized                DateTime
  refinance                 DateTime
  sale                      DateTime
  project                   Project   @relation(fields: [projectId], references: [id])
}

/// Project specific pictures
model ProjectPicture {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

/// project documents that all logged in users can see
model ProjectDocument {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  project            Project             @relation(fields: [projectId], references: [id])
  documentEvents     DocumentEvent[]
}

/// used to track who accessed which document when
model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  documentId Int
  date       DateTime
  type       DocumentEventType
  document   ProjectDocument   @relation(fields: [documentId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

///
model Address {
  id           Int            @id @default(autoincrement())
  street       String
  city         String
  zipcode      String
  state        String
  organization Organization[]
  user         User[]
}

enum DealDocumentType {
  K1
  VERIFICATION_ACCREDITATION
}

/// Role is not yet used
enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPORATION
  TRUST
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
}
