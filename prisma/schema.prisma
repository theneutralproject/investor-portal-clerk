generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  clerkId        String          @unique
  role           Role            @default(USER)
  email          String          @unique
  firstName      String
  lastName       String
  phoneNumber    String?
  hubspotId      String
  addressId      Int?
  ssn            String?
  title          String?
  deals          Deal[]
  documentEvents DocumentEvent[]
  meetings       Meeting[]
  address        Address?        @relation(fields: [addressId], references: [id])
}

model Meeting {
  id        Int      @id @default(autoincrement())
  url       String
  userId    Int
  projectId Int
  time      DateTime
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Project {
  id                   Int        @id @default(autoincrement())
  name                 String     @unique
  location             String
  investmentGoal       Float      @default(0.0)
  investmentRaised     Float      @default(0.0)
  tags                 String     @default("")
  status               Status     @default(ACTIVE)
  description          String
  buildingAvgRent      Int        @default(0)
  buildingAvgUnitSize  Int        @default(0)
  buildingCommSqFt     Int        @default(0)
  buildingUnits        Int        @default(0)
  debtInterestRate     String     @default("")
  debtMinInvestment    Int        @default(25000)
  debtPaymentFreq      String     @default("quarterly")
  debtTermMonths       Int        @default(48)
  equityIRR            Float      @default(0.0)
  equityMinInvestment  Int        @default(250000)
  equityPaymentFreq    String     @default("quarterly")
  equityTermMonths     Int        @default(60)
  marketHighlights     String     @default("")
  youtubeUrl           String     @default("")
  preferredReturn      String     @default("")
  targetEquityMultiple Float      @default(0.0)
  slug                 String     @unique
  deals                Deal[]
  documents            Document[]
  meetings             Meeting[]
  pictures             Pictures[]
  projectMilestones    ProjectMilestones?
  equityReturnsFile String? 
}

model ProjectMilestones {
  id                        Int      @id @default(autoincrement())
  projectId                 Int      @unique
  project                   Project  @relation(fields: [projectId], references: [id])
  equityContribution        DateTime
  financialClosing          DateTime
  groundBreakingCeremony    DateTime?
  startVerticalConstruction DateTime?
  toppingOut                DateTime?
  preLeasing                DateTime?
  fullEnclosure             DateTime?
  temporaryOccupancy        DateTime
  grandOpening              DateTime
  stabilized                DateTime
  refinance                 DateTime
  sale                      DateTime
}

model Pictures {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

model Document {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  project            Project             @relation(fields: [projectId], references: [id])
  documentEvents     DocumentEvent[]
}

model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  documentId Int
  date       DateTime
  type       DocumentEventType
  document   Document          @relation(fields: [documentId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

model Deal {
  id                      Int                @id @default(autoincrement())
  projectId               Int
  userId                  Int
  dealStage               Int
  amount                  Int
  financingType           DealFinancingType? @default(equity)
  hubspotId               String             @unique
  transactionId           String             @default("")
  investmentEntity        String
  numberAUnits            Float?             @default(0.0)
  numberCUnits            Float?             @default(0.0)
  ownershipType           DealOwnershipType?
  ownershipTypeOtherValue String?
  coSignerEmail           String?
  coSignerFullName        String?
  verifierEmail           String?
  verifierFullName        String?
  project                 Project            @relation(fields: [projectId], references: [id])
  user                    User               @relation(fields: [userId], references: [id])
}

model Address {
  id      Int       @id @default(autoincrement())
  street  String
  city    String
  zipcode String
  state   String
  Contact Contact[]
  User    User[]
}

model Contact {
  id        Int         @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  title     String?
  ssn       Float?
  type      ContactType
  addressId Int?
  address   Address?    @relation(fields: [addressId], references: [id])
}

enum ContactType {
  COSIGNER
  VERIFIER
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPROTATION
  REVOCABLEGRANTOR
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
}
