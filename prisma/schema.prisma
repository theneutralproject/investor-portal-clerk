generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  clerkId        String          @unique
  role           Role            @default(USER)
  email          String          @unique
  firstName      String
  lastName       String
  phoneNumber    String?
  hubspotId      String
  addressId      Int?
  ssn            String?
  title          String?
  organizationId Int
  organization   Organization[]
  documentEvents DocumentEvent[]
  address        Address?        @relation(fields: [addressId], references: [id])
}

model Deal {
  id                      Int                    @id @default(autoincrement())
  projectId               Int
  project                 Project                @relation(fields: [projectId], references: [id])
  dealStage               Int
  amount                  Int
  financingType           DealFinancingType?     @default(equity)
  hubspotId               String                 @unique
  transactionId           String                 @default("")
  /// the project, i.e. Edison LLC
  investmentEntity        String
  numberAUnits            Float?                 @default(0.0)
  numberCUnits            Float?                 @default(0.0)
  ownershipType           DealOwnershipType?
  ownershipTypeOtherValue String?
  AccreditationVerifier   AccreditationVerifier? @relation(fields: [accreditationVerifierId], references: [id])
  accreditationVerifierId Int?
  document                DealDocument[]
  organizationId          Int
  organization            Organization           @relation(fields: [organizationId], references: [id])
}

/// if deal.ownershipType === 'CORPROTATION', 'PARTNERSHIP', 'TRUST', create an Company
model Organization {
  id             Int                    @id @default(autoincrement())
  name           String
  members        User[]
  tin            String?
  dateOfCreation DateTime?
  juristication  String?
  deals          Deal[]
  document       OrganizationDocument[]
  addressId      Int?
  address        Address?               @relation(fields: [addressId], references: [id])
}

model AccreditationVerifier {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String
  title       String
  phoneNumber String
  deals       Deal[]
}

/// deal specific documents such as tax forms, accreditation verification etc 
model DealDocument {
  id     Int              @id @default(autoincrement())
  name   String
  link   String
  type   DealDocumentType
  dealId Int
  deal   Deal             @relation(fields: [dealId], references: [id])
}

/// used for business verification letters and such
model OrganizationDocument {
  id             Int          @id @default(autoincrement())
  name           String
  link           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum DealDocumentType {
  K1
  VERIFICATION_ACCREDITATION
}

model Project {
  id                   Int        @id @default(autoincrement())
  name                 String     @unique
  location             String
  investmentGoal       Float      @default(0.0)
  investmentRaised     Float      @default(0.0)
  tags                 String     @default("")
  status               Status     @default(ACTIVE)
  description          String
  buildingAvgRent      Int        @default(0)
  buildingAvgUnitSize  Int        @default(0)
  buildingCommSqFt     Int        @default(0)
  buildingUnits        Int        @default(0)
  debtInterestRate     String     @default("")
  debtMinInvestment    Int        @default(25000)
  debtPaymentFreq      String     @default("quarterly")
  debtTermMonths       Int        @default(48)
  equityIRR            Float      @default(0.0)
  equityMinInvestment  Int        @default(250000)
  equityPaymentFreq    String     @default("quarterly")
  equityTermMonths     Int        @default(60)
  marketHighlights     String     @default("")
  youtubeUrl           String     @default("")
  preferredReturn      String     @default("")
  targetEquityMultiple Float      @default(0.0)
  slug                 String     @unique
  deals                Deal[]
  documents            Document[]
  pictures             Pictures[]
  projectMilestones    ProjectMilestones?
  equityReturnsFile String? 
}

model ProjectMilestones {
  id                        Int       @id @default(autoincrement())
  projectId                 Int       @unique
  project                   Project   @relation(fields: [projectId], references: [id])
  equityContribution        DateTime
  financialClosing          DateTime
  groundBreakingCeremony    DateTime?
  startVerticalConstruction DateTime?
  toppingOut                DateTime?
  preLeasing                DateTime?
  fullEnclosure             DateTime?
  temporaryOccupancy        DateTime
  grandOpening              DateTime
  stabilized                DateTime
  refinance                 DateTime
  sale                      DateTime
}

/// Project specific pictures
model Pictures {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

/// project documents that all logged in users can see
model Document {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  project            Project             @relation(fields: [projectId], references: [id])
  documentEvents     DocumentEvent[]
}

/// used to track who accessed which document when
model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  documentId Int
  date       DateTime
  type       DocumentEventType
  document   Document          @relation(fields: [documentId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

/// 
model Address {
  id           Int            @id @default(autoincrement())
  street       String
  city         String
  zipcode      String
  state        String
  user         User[]
  organization Organization[]
}

/// Role is not yet used
enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPROTATION
  TRUST
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
}
