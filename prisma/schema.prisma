generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           Int                    @id @default(autoincrement())
  clerkId                      String?                @unique
  role                         Role                   @default(USER)
  email                        String                 @unique
  /// @encrypted
  firstName                    String
  /// @encrypted
  lastName                     String
  phoneNumber                  String?
  hubspotId                    String
  /// @encrypted?mode=strict
  ssn                          String?                @unique
  userOrgId                    Int?                   @unique
  referralSource               String?
  dateOfBirth                  DateTime?
  dateCreated                  DateTime?              @default(now())
  dateUpdated                  DateTime?              @updatedAt
  ActivityFeedItem             ActivityFeedItem[]
  address                      Address?
  AdvisorFirmEmployee          AdvisorFirmEmployee[]
  DealDocumentUploaded         DealDocument[]
  documentEvents               DocumentEvent[]
  DocusignEvent                DocusignEvent[]
  organizationMember           Member[]
  organizationsOwned           Organization[]         @relation("userOrg")
  OrganizationDocumentUploaded OrganizationDocument[]
  TermsEvents                  TermsEvents[]
}

model Deal {
  id                        Int                        @id @default(autoincrement())
  projectId                 Int
  dealStage                 Int                        @default(0)
  hubspotId                 String                     @unique
  transactionId             String                     @default("")
  /// the project, i.e. Edison LLC
  investmentEntity          String
  organizationId            Int
  closingDate               DateTime?
  signaturesCompletedDate   DateTime?
  dateFundsSent             DateTime?
  paymentMethod             PaymentMethod?
  paymentReferenceId        String?
  dateCreated               DateTime?                  @default(now())
  dateUpdated               DateTime?                  @updatedAt
  dateMatured               DateTime?
  status                    DealStatus?                @default(ACTIVE)
  accreditationVerification AccreditationVerification?
  organization              Organization               @relation(fields: [organizationId], references: [id])
  project                   Project                    @relation(fields: [projectId], references: [id])
  endDealConversion         DealConversion?            @relation("EndDealRelation")
  startDealConversion       DealConversion?            @relation("StartDealRelation")
  document                  DealDocument[]
  investmentStats           DealInvestmentStats?
  DocusignEvent             DocusignEvent[]
}

/// used to manifest the agreed upon terms of the deal
model DealInvestmentStats {
  id                    Int               @id @default(autoincrement())
  dealId                Int               @unique
  amount                Float             @default(5000.0)
  financingType         DealFinancingType @default(equity)
  unitType              DealUnitType      @default(AUNIT)
  ownershipType         DealOwnershipType @default(INDIVIDUAL)
  numberAUnits          Float             @default(0.0)
  numberCUnits          Float             @default(0.0)
  debtInterestRatePerc  Float             @default(0.0)
  debtPaymentFreq       String            @default("")
  debtTermMonthsMax     Int               @default(0)
  debtTermMonthsMin     Int               @default(0)
  equityTermMonths      Int               @default(0)
  debtPaymentFreqMonths Int               @default(0)
  equityPreferredReturn Float             @default(0.0)
  dateCreated           DateTime?         @default(now())
  dateUpdated           DateTime?         @updatedAt
  deal                  Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model DealConversion {
  id          Int       @id @default(autoincrement())
  startDealId Int       @unique
  endDealId   Int       @unique
  dateCreated DateTime? @default(now())
  dateUpdated DateTime? @updatedAt
  endDeal     Deal      @relation("EndDealRelation", fields: [endDealId], references: [id])
  startDeal   Deal      @relation("StartDealRelation", fields: [startDealId], references: [id])
}

model Organization {
  id             Int                    @id @default(autoincrement())
  /// @encrypted
  name           String
  ownerId        Int
  /// @encrypted?mode=strict
  tin            String?
  dateOfCreation DateTime?
  juristication  String?
  ownershipType  DealOwnershipType      @default(INDIVIDUAL)
  /// used to determine which organization is the primary individual one for the user
  isPrimary      Boolean                @default(false)
  advisorFirmId  Int?
  address        Address?
  deals          Deal[]
  members        Member[]
  advisorFirm    AdvisorFirm?           @relation("advisorClientOrganizations", fields: [advisorFirmId], references: [id])
  ownedBy        User                   @relation("userOrg", fields: [ownerId], references: [id], onDelete: Cascade)
  document       OrganizationDocument[]
}

model Member {
  id             Int            @id @default(autoincrement())
  userId         Int
  organizationId Int
  type           MembershipType
  title          String?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccreditationVerification {
  id         Int                    @id @default(autoincrement())
  dealId     Int                    @unique
  verifierId Int?                   @unique
  method     VerificationMethod
  basis      VerificationBasis
  deal       Deal                   @relation(fields: [dealId], references: [id])
  verifier   AccreditationVerifier? @relation(fields: [verifierId], references: [id])
}

model AccreditationVerifier {
  id                        Int                        @id @default(autoincrement())
  /// @encrypted?mode=strict
  firstName                 String
  /// @encrypted?mode=strict
  lastName                  String
  title                     String?
  phoneNumber               String?
  email                     String
  AccreditationVerification AccreditationVerification?
}

/// deal specific documents such as tax forms, accreditation verification etc 
model DealDocument {
  id           Int              @id @default(autoincrement())
  name         String
  type         DealDocumentType
  dealId       Int
  dateCreated  DateTime         @default(now())
  path         String
  uploadedById Int
  taxYear      Int?
  dateUpdated  DateTime?        @updatedAt
  deal         Deal             @relation(fields: [dealId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
}

/// used for business verification letters and such
model OrganizationDocument {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  dateCreated    DateTime     @default(now())
  path           String
  key            String       @default("")
  uploadedById   Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
}

model Project {
  id                   Int                     @id @default(autoincrement())
  name                 String                  @unique
  location             String
  tags                 String                  @default("")
  status               Status                  @default(ACTIVE)
  description          String
  marketHighlights     String                  @default("")
  youtubeUrl           String                  @default("")
  slug                 String                  @unique
  equityReturnsFile    String
  displayName          String                  @default("")
  deals                Deal[]
  equityMilestoneFiles EquityMilestoneFile[]
  documents            ProjectDocument[]
  investmentStats      ProjectInvestmentStats?
  milestones           ProjectMilestones?
  projectPaymentInfo   ProjectPaymentInfo[]
  pictures             ProjectPicture[]
  propertyStats        ProjectPropertyStats?
  ProjectReport        ProjectReport[]
}

model ProjectPropertyStats {
  id             Int     @id @default(autoincrement())
  avgRent        Int     @default(0)
  avgUnitSize    Int     @default(0)
  commercialSqFt Int     @default(0)
  numUnits       Int     @default(0)
  projectId      Int     @unique
  project        Project @relation(fields: [projectId], references: [id])
}

model ProjectInvestmentStats {
  id                          Int     @id @default(autoincrement())
  cUnitThresholdAmount        Float   @default(200000.0)
  bNoteThresholdAmount        Float?  @default(250000.0)
  debtMinInvestment           Int     @default(5000)
  debtPaymentFreq             String  @default("quarterly")
  equityMinInvestment         Int     @default(5000)
  equityPaymentFreq           String  @default("quarterly")
  equityTermMonths            Int     @default(60)
  investmentGoal              Float   @default(0.0)
  investmentRaised            Float   @default(0.0)
  projectId                   Int     @unique
  targetEquityMultiple        Float   @default(0.0)
  totalAUnitReturn            Float   @default(0.0)
  totalCUnitReturn            Float   @default(0.0)
  interestRateDollarThreshold Float   @default(250000)
  interestRateMax             Float   @default(12.0)
  interestRateMin             Float   @default(10.0)
  equityPreferredReturn       Float   @default(0.1)
  debtPaymentFreqMonths       Int     @default(3)
  debtTermMonthsMax           Int     @default(48)
  debtTermMonthsMin           Int     @default(48)
  equityPaymentFreqMonths     Int     @default(3)
  /// if the project is offering debt
  boolDebt                    Boolean @default(true)
  /// if the project is offering equity
  boolEquity                  Boolean @default(true)
  equityIRRMax                Float   @default(0.0)
  equityIRRMin                Float   @default(0.0)
  project                     Project @relation(fields: [projectId], references: [id])
}

model ProjectPaymentInfo {
  id               Int     @id @default(autoincrement())
  projectId        Int
  investmentEntity String
  /// @encrypted
  accountNumber    String
  /// @encrypted
  routingNumber    String
  project          Project @relation(fields: [projectId], references: [id])
}

model ProjectMilestones {
  id                        Int       @id @default(autoincrement())
  projectId                 Int       @unique
  equityContribution        DateTime
  financialClosing          DateTime
  groundBreakingCeremony    DateTime?
  startVerticalConstruction DateTime?
  toppingOut                DateTime?
  preLeasing                DateTime?
  fullEnclosure             DateTime?
  temporaryOccupancy        DateTime
  grandOpening              DateTime
  stabilized                DateTime
  refinance                 DateTime
  sale                      DateTime
  project                   Project   @relation(fields: [projectId], references: [id])
}

/// Project specific pictures
model ProjectPicture {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

/// project documents that all logged in users can see
model ProjectDocument {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  dateCreated        DateTime?           @default(now())
  dateUpdated        DateTime?           @updatedAt
  documentEvents     DocumentEvent[]
  project            Project             @relation(fields: [projectId], references: [id])
}

model ProjectReport {
  id          Int       @id @default(autoincrement())
  projectId   Int
  dateCreated DateTime  @default(now())
  dateUpdated DateTime? @updatedAt
  quarter     Int
  year        Int
  path        String
  name        String
  project     Project   @relation(fields: [projectId], references: [id])
}

/// used to track who accessed which document when
model DocumentEvent {
  id          Int               @id @default(autoincrement())
  userId      Int
  documentId  Int
  date        DateTime
  type        DocumentEventType
  dateCreated DateTime?         @default(now())
  dateUpdated DateTime?         @updatedAt
  document    ProjectDocument   @relation(fields: [documentId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
}

model DocusignEvent {
  id                         Int       @id @default(autoincrement())
  envelopeId                 String    @unique
  templateId                 String
  userId                     Int
  dealId                     Int
  dateSent                   DateTime?
  dateCompleted              DateTime?
  allSignaturesCompleted     Boolean   @default(false)
  investorSignatureCompleted Boolean   @default(false)
  dateCreated                DateTime? @default(now())
  dateUpdated                DateTime? @updatedAt
  deal                       Deal      @relation(fields: [dealId], references: [id])
  user                       User      @relation(fields: [userId], references: [id])
}

model Address {
  id             Int           @id @default(autoincrement())
  street         String
  city           String
  zipcode        String
  state          String
  country        String        @default("United States")
  organizationId Int?          @unique
  userId         Int?          @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TermsEvents {
  id           Int      @id @default(autoincrement())
  userId       Int
  dateAccepted DateTime
  revision     Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityFeedItem {
  id          String       @id @default(uuid())
  userId      Int
  header      String
  body        String
  dateCreated DateTime     @default(now())
  link        String?
  type        ActivityType
  itemId      Int?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, type], name: "activity_user_item_type")
}

model EquityMilestoneFile {
  id         Int      @id @default(autoincrement())
  projectId  Int
  fileName   String
  filePath   String
  publicUrl  String
  versionNum Int
  uploadedBy String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, fileName, versionNum])
}

model AdvisorFirm {
  id                  Int                   @id @default(autoincrement())
  name                String
  logoUrl             String?
  primaryContactId    Int?                  @unique
  primaryContact      AdvisorFirmEmployee?  @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  employees           AdvisorFirmEmployee[]
  clientOrganizations Organization[]        @relation("advisorClientOrganizations")
  dateCreated         DateTime              @default(now())
  dateUpdated         DateTime              @updatedAt
}

model AdvisorFirmEmployee {
  id            Int                 @id @default(autoincrement())
  advisorFirmId Int
  userId        Int
  role          AdvisorEmployeeRole
  isPrimary     Boolean             @default(false)

  advisorFirm AdvisorFirm @relation(fields: [advisorFirmId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  AdvisorFirmAsPrimaryContact AdvisorFirm[] @relation("PrimaryContact")

  @@unique([advisorFirmId, userId])
}

enum AdvisorEmployeeRole {
  ADMIN
  STAFF
}

enum ActivityType {
  EVENT
  PAYOUT
  TAX_DOCUMENT
  INVESTOR_DOCUMENT
  INVESTOR_REPORT
  NEW_INVESTMENT
}

enum DealDocumentType {
  K1
  VERIFICATION_ACCREDITATION
  INVESTMENT_DOCUMENT
  REPORT
}

enum Role {
  ADMIN
  USER
  ADVISOR
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum MembershipType {
  OWNER
  COINVESTOR
  CPA
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPORATION
  TRUST
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
  IRA
}

enum DealUnitType {
  AUNIT
  CUNIT
  BUNIT
  ANOTE
  BNOTE
  A1UNIT
}

enum DealStatus {
  ACTIVE
  PENDING
  MATURED
  LOST
}

enum VerificationBasis {
  INCOME
  ASSETS
  LICENSE
  OTHER
}

enum VerificationMethod {
  SELF
  THIRD_PARTY
}

enum PaymentMethod {
  ACH
  WIRE
  CHECK
}
