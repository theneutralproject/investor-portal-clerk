generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id             Int             @id @default(autoincrement())
  clerkId        String          @unique
  role           Role
  email          String          @unique
  firstName      String
  lastName       String
  phoneNumber    String
  hubspotId      String
  meetings       Meeting[]
  deals          Deal[]
  documentEvents DocumentEvent[]
}

model Meeting {
  id        Int      @id @default(autoincrement())
  url       String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  time      DateTime
}

enum Status {
  ACTIVE
  INACTIVE
}

model Project {
  id                  Int        @id @default(autoincrement())
  status              Status     @default(ACTIVE)
  name                String
  description         String
  marketHighlights    String     @default("")
  location            String
  tags                String     @default("")
  investmentRaised    Float      @default(0.0)
  investmentGoal      Float      @default(0.0)
  equityIRR           Float      @default(0.0)
  equityMinInvestment Int        @default(250000)
  equityTermMonths    Int        @default(60)
  equityPaymentFreq   String     @default("quarterly")
  debtInterestRate    Float      @default(0.0)
  debtMinInvestment   Int        @default(25000)
  debtTermMonths      Int        @default(60)
  debtPaymentFreq     String     @default("quarterly")
  buildingUnits       Int        @default(0)
  buildingAvgUnitSize Int        @default(0)
  buildingAvgRent     Int        @default(0)
  buildingCommSqFt    Int        @default(0)
  pictures            Pictures[]
  meetings            Meeting[]
  documents           Document[]
  deals               Deal[]
}

enum PictureType {
  HEADER
  GALLERY
  CARD
  OTHER
}

model Pictures {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id])
  url       String
  type      PictureType
}

model Document {
  id             Int             @id @default(autoincrement())
  name           String
  fileName       String
  description    String
  link           String
  projectId      Int
  project        Project         @relation(fields: [projectId], references: [id])
  dealStage      Int
  documentEvents DocumentEvent[]
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  documentId Int
  document   Document          @relation(fields: [documentId], references: [id])
  date       DateTime
  type       DocumentEventType
}

model Deal {
  id            Int                @id @default(autoincrement())
  projectId     Int
  project       Project            @relation(fields: [projectId], references: [id])
  userId        Int
  user          User               @relation(fields: [userId], references: [id])
  dealStage     Int
  amount        Int
  hubspotId     String             @unique
  financingType DealFinancingType?
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
}
