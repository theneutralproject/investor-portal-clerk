generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "npx zod-prisma-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int             @id @default(autoincrement())
  clerkId            String?         @unique
  role               Role            @default(USER)
  email              String          @unique
  firstName          String
  lastName           String
  phoneNumber        String?
  hubspotId          String
  ssn                String?
  dateOfBirth        DateTime?
  userOrgId          Int?            @unique
  referralSource     String?
  deal               Deal[]
  documentEvents     DocumentEvent[]
  address            Address?
  organizationMember Member[]
  organizationsOwned Organization[]  @relation(name: "userOrg")
}

model Deal {
  id                      Int                    @id @default(autoincrement())
  projectId               Int
  /// @deprecated Use `organizationId` instead.
  userId                  Int?
  dealStage               Int
  /// @deprecated. Use DealInvestmentStats model instead
  amount                  Float                  @default(5000.0)
  /// @deprecated. Use DealInvestmentStats model instead
  financingType           DealFinancingType?     @default(equity)
  hubspotId               String                 @unique
  transactionId           String                 @default("")
  /// the project, i.e. Edison LLC
  investmentEntity        String
  /// @deprecated. Use DealInvestmentStats model instead
  ownershipType           DealOwnershipType?     @default(INDIVIDUAL)
  accreditationVerifierId Int?
  organizationId          Int
  accreditationVerifier   AccreditationVerifier? @relation(fields: [accreditationVerifierId], references: [id])
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project                 Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                    User?                  @relation(fields: [userId], references: [id])
  document                DealDocument[]
  investmentStats         DealInvestmentStats?
}

model DealInvestmentStats {
  id            Int                @id @default(autoincrement())
  dealId        Int                @unique
  amount        Float              @default(0.0)
  financingType DealFinancingType? @default(equity)
  unitType      DealUnitType       @default(AUNIT)
  ownershipType DealOwnershipType? @default(INDIVIDUAL)
  numberAUnits  Float              @default(0.0)
  numberCUnits  Float              @default(0.0)
  deal          Deal               @relation(fields: [dealId], references: [id])
}

model Organization {
  id             Int                    @id @default(autoincrement())
  name           String
  ownerId        Int
  tin            String?
  dateOfCreation DateTime?
  juristication  String?
  isPrimary      Boolean                @default(false) /// used to determine which organization is the primary individual one for the user
  ownershipType  DealOwnershipType      @default(INDIVIDUAL)
  deals          Deal[]
  address        Address?
  document       OrganizationDocument[]
  ownedBy        User                   @relation(name: "userOrg", fields: [ownerId], references: [id], onDelete: Cascade)
  members        Member[]
}

model Member {
  id             Int            @id @default(autoincrement())
  userId         Int
  organizationId Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           MembershipType
}

model AccreditationVerifier {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  title       String?
  phoneNumber String?
  deals       Deal[]
}

/// deal specific documents such as tax forms, accreditation verification etc 
model DealDocument {
  id     Int              @id @default(autoincrement())
  name   String
  link   String
  type   DealDocumentType
  dealId Int
  deal   Deal             @relation(fields: [dealId], references: [id])
}

/// used for business verification letters and such
model OrganizationDocument {
  id             Int          @id @default(autoincrement())
  name           String
  link           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Project {
  id                Int                     @id @default(autoincrement())
  name              String                  @unique
  location          String
  tags              String                  @default("")
  status            Status                  @default(ACTIVE)
  description       String
  marketHighlights  String                  @default("")
  youtubeUrl        String                  @default("")
  slug              String                  @unique
  equityReturnsFile String?
  deals             Deal[]
  documents         ProjectDocument[]
  investmentStats   ProjectInvestmentStats?
  milestones        ProjectMilestones?
  pictures          ProjectPicture[]
  propertyStats     ProjectPropertyStats?
}

model ProjectPropertyStats {
  id             Int     @id @default(autoincrement())
  avgRent        Int     @default(0)
  avgUnitSize    Int     @default(0)
  commercialSqFt Int     @default(0)
  numUnits       Int     @default(0)
  projectId      Int     @unique
  project        Project @relation(fields: [projectId], references: [id])
}

model ProjectInvestmentStats {
  id                   Int     @id @default(autoincrement())
  cUnitThresholdAmount Float   @default(200000.0)
  debtInterestRate     String  @default("")
  debtMinInvestment    Int     @default(5000)
  debtPaymentFreq      String  @default("quarterly")
  debtTermMonths       Int     @default(48)
  equityIRR            Float   @default(0.0)
  equityMinInvestment  Int     @default(5000)
  equityPaymentFreq    String  @default("quarterly")
  equityTermMonths     Int     @default(60)
  preferredReturn      String  @default("")
  investmentGoal       Float   @default(0.0)
  investmentRaised     Float   @default(0.0)
  projectId            Int     @unique
  targetEquityMultiple Float   @default(0.0)
  totalAUnitReturn     Float   @default(0.0)
  totalCUnitReturn     Float   @default(0.0)
  project              Project @relation(fields: [projectId], references: [id])
}

model ProjectMilestones {
  id                        Int       @id @default(autoincrement())
  projectId                 Int       @unique
  equityContribution        DateTime
  financialClosing          DateTime
  groundBreakingCeremony    DateTime?
  startVerticalConstruction DateTime?
  toppingOut                DateTime?
  preLeasing                DateTime?
  fullEnclosure             DateTime?
  temporaryOccupancy        DateTime
  grandOpening              DateTime
  stabilized                DateTime
  refinance                 DateTime
  sale                      DateTime
  project                   Project   @relation(fields: [projectId], references: [id])
}

/// Project specific pictures
model ProjectPicture {
  id        Int         @id @default(autoincrement())
  projectId Int
  url       String
  type      PictureType
  project   Project     @relation(fields: [projectId], references: [id])
}

/// project documents that all logged in users can see
model ProjectDocument {
  id                 Int                 @id @default(autoincrement())
  name               String
  fileName           String
  description        String?
  link               String
  projectId          Int
  dealStage          Int
  financingTypes     DealFinancingType[] @default([])
  documentType       DocumentType        @default(DOCUMENT)
  docusignTemplateId String?
  documentEvents     DocumentEvent[]
  project            Project             @relation(fields: [projectId], references: [id])
}

/// used to track who accessed which document when
model DocumentEvent {
  id         Int               @id @default(autoincrement())
  userId     Int
  documentId Int
  date       DateTime
  type       DocumentEventType
  document   ProjectDocument   @relation(fields: [documentId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

model Address {
  id             Int           @id @default(autoincrement())
  street         String
  city           String
  zipcode        String
  state          String
  country        String        @default("United States")
  organization   Organization? @relation(onDelete: Cascade, fields: [organizationId], references: [id])
  organizationId Int?          @unique
  user           User?         @relation(onDelete: Cascade, fields: [userId], references: [id])
  userId         Int?          @unique
}

enum DealDocumentType {
  K1
  VERIFICATION_ACCREDITATION
}

/// Role is not yet used
enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum PictureType {
  HEADER
  GALLERY
  OTHER
  CARD
}

enum DocumentType {
  YOUTUBE
  DOCUSIGN
  DOCUMENT
}

enum DocumentEventType {
  VIEW
  DOWNLOAD
  SIGN
}

enum MembershipType {
  OWNER
  COINVESTOR
  CPA
}

enum DealFinancingType {
  equity
  promissory_note_now
  promissory_to_equity
  promissory_note_at_closing
}

enum DealOwnershipType {
  INDIVIDUAL
  JOINT
  CORPORATION
  TRUST
  OTHER
  MARITAL
  COMMON
  PARTNERSHIP
}

enum DealUnitType {
  AUNIT
  CUNIT
}
