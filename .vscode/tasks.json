{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "typescript",
			"tsconfig": "tsconfig.json",
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "tsc: build - tsconfig.json"
		},         {
            "label": "dev-with-clerk",
            "runOptions": {
                "runOn": "default"
            },
            "dependsOrder": "parallel",
            "dependsOn": [
                "run-dev",
                "run-tunnel"
            ]
        },
        {
            "label": "run-dev",
            "type": "shell",
            "command": "npm run dev",
            "presentation": {
                "panel": "dedicated"
            }
        },
        {
            "label": "run-tunnel",
            "type": "shell",
            "command": "npx lt --port 3000 --subdomain neutral-invest",
            "presentation": {
                "panel": "dedicated"
            }
        }
	]
}